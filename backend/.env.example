# Copy this file to .env and fill in real values before running in production.

PORT=5000

# Long, random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Seed admin account — created automatically the first time the server starts
# if no user with this email exists yet. Change the password immediately
# after first login (or before deploying) by editing data/db.json or adding
# a password-change endpoint.
ADMIN_NAME=HQ Admin
ADMIN_EMAIL=admin@exceltravel.rw
ADMIN_PASSWORD=ChangeMe123!

# Comma-separated list of allowed origins, or * for any (fine for local dev).
CORS_ORIGIN=*
